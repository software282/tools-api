// Seattle Solvers Tools API — data model
// Postgres (Supabase). See ../.env.example for connection settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  MEMBER
  TEAM_ADMIN
  SUPER_ADMIN
}

// Whether a part belongs to the shared global library or to a single team.
enum PartScope {
  GLOBAL
  TEAM
}

// Review status for parts (global library submissions use PENDING).
enum PartStatus {
  APPROVED
  PENDING
  REJECTED
}

enum Vendor {
  GOBILDA
  REV
  AXON
  FERRA
  MELONBOTICS
  OFFSET
  MATA
  UXCELL
  OTHER
}

enum ReceiptStatus {
  PROCESSING
  PARSED
  CONFIRMED
  FAILED
}

// How a receipt's text was obtained. Most orders are placed online, so the
// digital paths (pasted text, HTML email, born-digital PDF) are the common case
// and involve no OCR and no model call at all. TESSERACT/CLAUDE_VISION exist for
// photos of physical receipts.
enum ExtractionMethod {
  PASTED_TEXT // order confirmation pasted as plain text
  PASTED_HTML // order confirmation email pasted as HTML
  PDF_TEXT // text layer of a digital PDF invoice
  TESSERACT // OCR of a photo or screenshot
  CLAUDE_TEXT // digital text no vendor parser could read
  CLAUDE_VISION // image neither OCR nor the vendor parsers could read
}

// ─────────────────────────── Accounts ───────────────────────────

model Team {
  id         String   @id @default(cuid())
  number     Int      @unique
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Each team supplies its own Anthropic key for the Claude receipt/product-url
  // fallbacks — this is a shared multi-team service, so there is no single
  // account to bill. Encrypted at rest (see src/lib/secretBox.ts); never
  // decrypted for display, only used server-side to call the Anthropic API.
  anthropicApiKeyCiphertext String?

  users          User[]
  inventory      InventoryItem[]
  receipts       Receipt[]
  createdParts   Part[]          @relation("PartCreatedByTeam")
  expenseEntries ExpenseEntry[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Bumped whenever every existing session for this user must stop working
  // (password change, "sign out everywhere"). Tokens carry the value they were
  // issued with; a mismatch is rejected. See src/plugins/auth.ts.
  tokenVersion Int @default(0)

  // Nullable so a SUPER_ADMIN (Seattle Solvers staff) need not belong to a team.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  createdParts     Part[]    @relation("PartCreatedByUser")
  uploadedReceipts Receipt[]

  @@index([teamId])
}

// ─────────────────────────── Catalog ───────────────────────────

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique
  sort Int    @default(0)

  parts Part[]
}

model Manufacturer {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  websiteUrl String?

  parts Part[]

  // Which Vendor enum this manufacturer maps to for receipt parsing (if any).
  vendor Vendor?
}

model Part {
  id          String     @id @default(cuid())
  name        String
  sku         String?
  description String?
  productUrl  String? // item / product detail page
  purchaseUrl String? // add-to-cart / buy page (often same as productUrl)
  imageUrl    String?
  scope       PartScope  @default(GLOBAL)
  status      PartStatus @default(APPROVED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The last unit price actually seen for this part — from a parsed receipt
  // line, a manual entry when adding it, or (for imported catalog parts) a
  // vendor listing. Nullable: not every part has one yet. This is a rolling
  // "last known" figure, not a live quote, and is what GET /expenses falls
  // back to for any inventory increase that carries no price of its own (a
  // manual +1 rather than a scanned receipt) — see ExpenseEntry.source.
  lastKnownPrice Decimal? @db.Decimal(10, 2)

  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Provenance for team-created parts / library submissions.
  createdByTeamId String?
  createdByTeam   Team?   @relation("PartCreatedByTeam", fields: [createdByTeamId], references: [id])
  createdByUserId String?
  createdByUser   User?   @relation("PartCreatedByUser", fields: [createdByUserId], references: [id])

  inventoryItems   InventoryItem[]
  receiptLineItems ReceiptLineItem[]
  expenseEntries   ExpenseEntry[]

  @@index([manufacturerId])
  @@index([categoryId])
  @@index([scope, status])
  @@index([createdByTeamId])
}

// ─────────────────────────── Inventory ───────────────────────────

model InventoryItem {
  id       String  @id @default(cuid())
  quantity Int     @default(0)
  location String?
  notes    String?

  // The stock level this team wants to keep. 0 means "don't track", so the
  // feature is opt-in per part and inert until someone sets a threshold —
  // realistically only a handful of critical parts ever will.
  minQuantity Int @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  partId String
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([teamId, partId])
  @@index([teamId])
}

// ─────────────────────────── Receipts ───────────────────────────

model Receipt {
  id          String            @id @default(cuid())
  vendor      Vendor
  // Storage path of the uploaded file, when there was one — NOT a URL. The
  // receipts bucket is private, so a URL is signed on demand and expires; only
  // the path is durable. Null for pasted text, which is the most common case.
  filePath    String?
  status      ReceiptStatus     @default(PROCESSING)
  method      ExtractionMethod?
  rawText     String? // the extracted text, whatever the source
  parsedJson  Json? // structured parse result (from vendor parser or Claude)
  orderTotal  Decimal?          @db.Decimal(10, 2)
  purchasedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  uploadedByUserId String?
  uploadedByUser   User?   @relation(fields: [uploadedByUserId], references: [id])

  lineItems      ReceiptLineItem[]
  expenseEntries ExpenseEntry[]

  @@index([teamId])
}

model ReceiptLineItem {
  id              String   @id @default(cuid())
  rawText         String?
  parsedName      String
  parsedSku       String?
  quantity        Int      @default(1)
  unitPrice       Decimal? @db.Decimal(10, 2)
  lineTotal       Decimal? @db.Decimal(10, 2)
  matchConfidence Float    @default(0) // 0-1, how confident the part match is
  applied         Boolean  @default(false) // whether it was written to inventory

  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  matchedPartId String?
  matchedPart   Part?   @relation(fields: [matchedPartId], references: [id])

  @@index([receiptId])
}

// ─────────────────────────── Expenses ───────────────────────────

// Where an ExpenseEntry's unitCost actually came from — surfaced in
// GET /expenses so a team can tell an exact price from an estimated one.
enum ExpenseSource {
  RECEIPT   // this specific purchase carried its own parsed price
  ESTIMATED // no price on this purchase itself — fell back to Part.lastKnownPrice,
            // however that got set (an earlier receipt, or typed in by hand
            // via POST /parts's unitCost when adding a brand-new part)
}

// One row per inventory-quantity increase with a known cost. Created
// alongside the increment itself — inside the same transaction, on
// POST /receipts/:id/confirm and POST /inventory/:partId/adjust — so an
// expense row and the stock change it represents can never drift apart.
// GET /expenses aggregates straight from this; nothing here is a cache.
// A quantity increase with no knowable cost (no receipt price, and the part
// has no lastKnownPrice yet) simply creates no row — never a fabricated one.
model ExpenseEntry {
  id        String        @id @default(cuid())
  quantity  Int
  unitCost  Decimal       @db.Decimal(10, 2)
  totalCost Decimal       @db.Decimal(10, 2) // quantity * unitCost, stored so aggregation is a plain SUM
  source    ExpenseSource
  createdAt DateTime      @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Nullable, no onDelete (defaults to SetNull): if the part is later
  // deleted, the money it was spent on should outlive it as history, same
  // as ReceiptLineItem.matchedPart above — excluded from GET /expenses'
  // per-part breakdown once orphaned, but never silently destroyed.
  partId String?
  part   Part?   @relation(fields: [partId], references: [id])

  // Nullable, no onDelete: no delete route exists for Receipt today, but an
  // ESTIMATED/MANUAL entry never has one anyway, and this should survive a
  // delete route being added later without a migration.
  receiptId String?
  receipt   Receipt? @relation(fields: [receiptId], references: [id])

  @@index([teamId, partId])
  @@index([teamId, createdAt])
}

// ─────────────────────────── Usage ───────────────────────────

// One row per API request, for GET /admin/stats — capacity planning across
// however many teams end up on this (see SETUP.md's traffic-estimate note).
// Deliberately no relation/FK to Team or User: this is a historical record of
// what happened, and must stay intact and queryable even after a team leaves
// or an account is removed. /health is excluded at the call site — Render's
// own health-check pings it far more often than any real usage ever would.
model RequestLog {
  id         String   @id @default(cuid())
  method     String
  path       String
  statusCode Int
  durationMs Int
  teamId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([teamId, createdAt])
}
