# ─────────────────────────────────────────────────────────────
# Seattle Solvers Tools API — environment configuration
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS (the future frontend).
# Use * only for local development.
CORS_ORIGINS=http://localhost:5173

# Auth
# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Supabase database
#
# Copy these from the Supabase dashboard: Project → Connect. Do not hand-build
# them; the host and username format differ per connection mode.
#
# Two URLs are needed because Prisma uses them differently:
#   DATABASE_URL — normal queries. Use the *transaction* pooler (port 6543) and
#                  keep ?pgbouncer=true, without which Prisma's prepared
#                  statements break in intermittent, hard-to-diagnose ways.
#   DIRECT_URL   — migrations only. Needs a *session* connection (port 5432);
#                  migrations cannot run through the transaction pooler.
#
# IMPORTANT: prefer the pooler host (…pooler.supabase.com) over the direct host
# (db.<ref>.supabase.co). The direct host resolves to IPv6 only unless your
# project has the IPv4 add-on, and on most networks that shows up as a
# connection timeout rather than a useful error.
#
# Run `npm run db:check` after filling these in — it diagnoses the common
# failures in plain language.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Project settings → API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key — server-side only, grants full storage access. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket that holds uploaded receipt images (create it in Supabase → Storage).
SUPABASE_RECEIPTS_BUCKET=receipts

# ─────────────────────────────────────────────────────────────
# Claude (receipt vision / product-URL fallback)
#
# This is a shared, multi-team service, so there is no single Anthropic key to
# put here — each team pastes its own via `PATCH /teams/current`
# (`anthropicApiKey`), encrypted at rest with ENCRYPTION_KEY below. A team with
# no key configured simply gets no AI fallback (deterministic paths and manual
# entry still work).
# ─────────────────────────────────────────────────────────────
# Encrypts each team's stored Anthropic key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Model used for every team's Claude calls. Receipt extraction is not
# reasoning-heavy, so claude-haiku-4-5 is a much cheaper alternative if the
# fallback ever accounts for meaningful spend.
ANTHROPIC_RECEIPT_MODEL=claude-opus-5

# Receipt OCR tuning
# Tesseract mean-confidence (0-100) below which we fall back to Claude.
OCR_CONFIDENCE_THRESHOLD=70

# ─────────────────────────────────────────────────────────────
# Rate limiting (requests per minute, per IP)
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
# Applies to login / signup / join / password change, where guessing is the attack.
RATE_LIMIT_AUTH_MAX=10
# Applies to receipt intake, the costliest work here (PDF parsing, OCR, Claude).
RATE_LIMIT_RECEIPT_MAX=30

# ─────────────────────────────────────────────────────────────
# Super admin (the part-library reviewer)
# ─────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=software@seattlesolvers.com
# Used ONLY by `npm run seed`, and only when the account does not exist yet.
# Must be at least 12 characters — the seed fails rather than creating the
# account that can approve parts for every team with a weak password.
# Re-running the seed never changes an existing admin's password.
SUPER_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Transactional email (Resend — https://resend.com)
# ─────────────────────────────────────────────────────────────
# Get one from the Resend dashboard. Left unset, part-submission
# notification emails are silently skipped (never fatal — see src/lib/email.ts).
RESEND_API_KEY=
# Must be on a domain verified in Resend (add its DNS records — SPF/DKIM — in
# Cloudflare for seattlesolvers.com), or every send fails.
EMAIL_FROM=Seattle Solvers Tools <notifications@seattlesolvers.com>
# Comma-separated. Who hears about a new shared-library part request.
PART_SUBMISSION_NOTIFY_EMAILS=george.conlan@eastsidecatholicschool.org,software@seattlesolvers.com
# The deployed frontend's origin, for the sign-in link in that email.
FRONTEND_URL=https://tools.seattlesolvers.com
