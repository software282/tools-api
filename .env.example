# ─────────────────────────────────────────────────────────────
# Seattle Solvers Tools API — environment configuration
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS (the future frontend).
# Use * only for local development.
CORS_ORIGINS=http://localhost:5173

# Auth
# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Supabase
# Project settings → Database → Connection string (use the pooled
# "Transaction" connection string for serverless, or "Session" for a
# long-running server). Prisma needs the DIRECT (non-pooled) URL for
# migrations.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Project settings → API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key — server-side only, grants full storage access. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket that holds uploaded receipt images (create it in Supabase → Storage).
SUPABASE_RECEIPTS_BUCKET=receipts

# ─────────────────────────────────────────────────────────────
# Claude (receipt vision fallback)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model used for reading receipt images.
ANTHROPIC_RECEIPT_MODEL=claude-opus-4-8

# Receipt OCR tuning
# Tesseract mean-confidence (0-100) below which we fall back to Claude.
OCR_CONFIDENCE_THRESHOLD=70

# The email that is seeded as the SUPER_ADMIN (part-library reviewer).
SUPER_ADMIN_EMAIL=software@seattlesolvers.com
# Initial password for the seeded super admin (change after first login).
SUPER_ADMIN_PASSWORD=change-me
